</div><script>
let timing = 'laser';
const HAND_ADJ = 0.24;

function setTiming(t, btn) {
  timing = t;
  document.querySelectorAll('.format-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// Position benchmarks in electronic seconds: [average (50th pct), elite (top 10%)]
// NFL: combine averages by position. HS: midpoint of varsity average range + elite cutoff.
const POS = {
  ALL: { name: 'All positions',          nfl: [4.54, 4.30], hs: [4.88, 4.60] },
  WR:  { name: 'Wide Receiver',          nfl: [4.48, 4.30], hs: [4.775, 4.50] },
  CB:  { name: 'Cornerback',             nfl: [4.47, 4.30], hs: [4.775, 4.50] },
  RB:  { name: 'Running Back',           nfl: [4.49, 4.33], hs: [4.825, 4.55] },
  S:   { name: 'Safety',                 nfl: [4.53, 4.37], hs: [4.90, 4.60] },
  LB:  { name: 'Linebacker',             nfl: [4.68, 4.46], hs: [4.90, 4.60] },
  QB:  { name: 'Quarterback',            nfl: [4.71, 4.48], hs: [4.95, 4.65] },
  TE:  { name: 'Tight End',              nfl: [4.70, 4.50], hs: [4.95, 4.68] },
  DE:  { name: 'Defensive End',          nfl: [4.74, 4.50], hs: [4.975, 4.70] },
  DT:  { name: 'Defensive Tackle',       nfl: [4.99, 4.65], hs: [5.25, 4.95] },
  OL:  { name: 'Offensive Guard/Tackle', nfl: [5.10, 4.80], hs: [5.40, 5.00] },
  C:   { name: 'Center',                 nfl: [5.15, 4.85], hs: [5.40, 5.00] },
};
const LEVEL_NAME = { nfl: 'NFL combine', hs: 'high school varsity' };

// Standard normal CDF (Abramowitz-Stegun approximation)
function phi(z) {
  const t = 1 / (1 + 0.2316419 * Math.abs(z));
  const d = 0.3989423 * Math.exp(-z * z / 2);
  const p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
  return z > 0 ? 1 - p : p;
}

function percentile(t, avg, elite) {
  const sd = (avg - elite) / 1.2816;      // elite = top 10% => z = 1.2816
  const pct = phi((avg - t) / sd) * 100;  // faster (lower) time => higher percentile
  return Math.max(1, Math.min(99, pct));
}

function mph(t) { return (36.576 / t) * 2.23694; }

function getColor(pct) {
  if (pct < 10) return '#ff4d4d';
  if (pct < 25) return '#ff9000';
  if (pct < 40) return '#ffd600';
  if (pct < 60) return '#9dff00';
  if (pct < 85) return '#aaff00';
  return '#00cfff';
}

const verdicts = [
  { max: 10,  label: 'Well Below Average' },
  { max: 25,  label: 'Below Average' },
  { max: 40,  label: 'Slightly Below Average' },
  { max: 60,  label: 'Right Around Average' },
  { max: 75,  label: 'Above Average' },
  { max: 90,  label: 'Fast' },
  { max: 97,  label: 'Elite Speed' },
  { max: 101, label: 'Exceptional — Top 3%' },
];

function animateNumber(el, target, duration) {
  const start = performance.now();
  const from = parseFloat(el.textContent) || 0;
  function step(now) {
    const p = Math.min((now - start) / duration, 1);
    const ease = 1 - Math.pow(1 - p, 4);
    el.textContent = Math.round(from + (target - from) * ease);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function calculate() {
  const inputEl = document.getElementById('t40');
  const raw = parseFloat(inputEl.value);
  if (isNaN(raw) || raw < 3.8 || raw > 8) {
    inputEl.style.borderColor = 'var(--red)';
    inputEl.focus();
    setTimeout(() => inputEl.style.borderColor = '', 1500);
    return;
  }
  const posKey = document.getElementById('pos').value;
  const level  = document.getElementById('level').value;
  const wt     = parseFloat(document.getElementById('wt').value);
  const pos    = POS[posKey];

  const t = timing === 'hand' ? raw + HAND_ADJ : raw;
  const [avg, elite] = pos[level];
  const pct   = Math.round(percentile(t, avg, elite));
  const color = getColor(pct);
  const v     = verdicts.find(x => pct < x.max) || verdicts[verdicts.length - 1];
  const speedScore = !isNaN(wt) && wt > 0 ? (wt * 200) / Math.pow(t, 4) : null;

  const resultsEl = document.getElementById('results');
  resultsEl.classList.add('visible');
  resultsEl.querySelectorAll('.anim').forEach(el => { el.style.animation = 'none'; el.offsetHeight; el.style.animation = ''; });

  // Conversions
  const conv = [
    [t.toFixed(2) + 's', timing === 'hand' ? 'Electronic Equiv.' : 'Electronic 40'],
    [mph(t).toFixed(1), 'Avg mph'],
    [(t * 2.5).toFixed(1) + 's', '100m Equiv.'],
  ];
  if (speedScore) conv.push([speedScore.toFixed(1), 'Speed Score']);
  document.getElementById('conversions-row').innerHTML = conv.map(([val, label]) =>
    `<div class="conv-item"><div class="conv-val" style="color:${color}">${val}</div><div class="conv-label">${label}</div></div>`).join('');

  // Gauge
  const gaugeNum = document.getElementById('gauge-num');
  const gaugePath = document.getElementById('gauge-path');
  const totalLen = 345;
  gaugePath.style.stroke = color;
  gaugePath.style.strokeDashoffset = totalLen;
  setTimeout(() => { gaugePath.style.strokeDashoffset = totalLen - (pct / 100) * totalLen; }, 50);
  animateNumber(gaugeNum, pct, 1200);
  gaugeNum.style.fill = color;

  const posLabel = posKey === 'ALL' ? 'players' : pos.name.toLowerCase() + 's';
  document.getElementById('verdict').textContent = v.label;
  document.getElementById('verdict').style.color = color;
  const diff = avg - t;
  document.getElementById('verdict-sub').textContent =
    `Faster than about ${pct}% of ${LEVEL_NAME[level]} ${posLabel}. ` +
    (Math.abs(diff) < 0.02 ? `You're right at the ${avg.toFixed(2)}s average.`
      : diff > 0 ? `That's ${diff.toFixed(2)}s faster than the ${avg.toFixed(2)}s average.`
      : `That's ${Math.abs(diff).toFixed(2)}s slower than the ${avg.toFixed(2)}s average.`);

  // Compare cards: HS avg, NFL avg, NFL elite for the chosen position, + speed score
  const cards = [
    ['High School Avg', pos.hs[0], '🏫', '#111a10'],
    ['NFL Combine Avg', pos.nfl[0], '🏈', '#1a1510'],
    ['NFL Elite (Top 10%)', pos.nfl[1], '⚡', '#1a1020'],
  ];
  const grid = document.getElementById('compare-grid');
  grid.innerHTML = '';
  cards.forEach(([name, ref, icon, bg]) => {
    const d = ref - t;
    const badge = d > 0.02 ? `<span class="badge badge-above">${d.toFixed(2)}s faster</span>`
      : d < -0.02 ? `<span class="badge badge-below">${Math.abs(d).toFixed(2)}s slower</span>`
      : `<span class="badge badge-at">Even</span>`;
    const card = document.createElement('div');
    card.className = 'compare-card';
    card.innerHTML = `<div class="compare-icon" style="background:${bg}">${icon}</div>
      <div class="compare-text"><div class="compare-title">${name}</div><div class="compare-val">${badge}</div>
      <div class="compare-avg">${posKey === 'ALL' ? 'All positions' : pos.name}: ${ref.toFixed(2)}s · ${mph(ref).toFixed(1)} mph</div></div>`;
    grid.appendChild(card);
  });

  // Bars: you vs every NFL position average, fastest first
  const rows = Object.entries(POS).filter(([k]) => k !== 'ALL')
    .map(([k, p]) => ({ label: p.name, t: p.nfl[0] }))
    .concat([{ label: 'You', t, isYou: true }])
    .sort((a, b) => a.t - b.t);
  const fastest = Math.min(...rows.map(r => r.t));
  const slowest = Math.max(...rows.map(r => r.t));
  const barsWrap = document.getElementById('bars-wrap');
  barsWrap.innerHTML = '';
  rows.forEach(d => {
    const w = slowest === fastest ? 100 : 25 + 75 * (slowest - d.t) / (slowest - fastest);
    const row = document.createElement('div');
    row.className = 'bar-row' + (d.isYou ? ' you-row' : '');
    row.innerHTML = `<div class="bar-label">${d.label}</div>
      <div class="bar-track"><div class="bar-fill" style="width:0%;background:${d.isYou ? color : '#1e2c3a'}" data-w="${w}"></div></div>
      <div class="bar-val">${d.t.toFixed(2)}s</div>`;
    barsWrap.appendChild(row);
  });
  setTimeout(() => { document.querySelectorAll('.bar-fill').forEach(b => { b.style.width = b.dataset.w + '%'; }); }, 100);

  // Tip
  const matched = Object.values(POS).filter(p => p.name !== 'All positions' && t <= p.nfl[0]).map(p => p.name.toLowerCase());
  let tip = matched.length
    ? `<strong>NFL comparison:</strong> Your ${t.toFixed(2)} is as fast as or faster than the average NFL combine ${matched.slice(0, 3).join(', ')}${matched.length > 3 ? ` and ${matched.length - 3} more position group${matched.length - 3 > 1 ? 's' : ''}` : ''}. `
    : `<strong>NFL comparison:</strong> Your ${t.toFixed(2)} is ${(t - 5.15).toFixed(2)}s off the slowest NFL position average (centers, 5.15s). `;
  if (speedScore) {
    tip += `Your Speed Score of <strong>${speedScore.toFixed(1)}</strong> is ${speedScore >= 110 ? 'excellent' : speedScore >= 100 ? 'above the ~100 typical of an NFL running back prospect' : speedScore >= 90 ? 'a bit under the ~100 typical of an NFL running back prospect' : 'well under the ~100 typical of an NFL running back prospect'}. `;
  }
  tip += pct < 50
    ? `Biggest lever: your <strong>start and first 10 yards</strong>. Work stance, first-step angles and sled pushes 2x a week.`
    : `To keep dropping time, train <strong>max velocity</strong> with flying 20s and keep building lower-body strength.`;
  if (timing === 'hand') tip += ` (We added ${HAND_ADJ}s to your hand time to match electronic combine timing.)`;
  document.getElementById('tip-text').innerHTML = tip;

  setTimeout(() => resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
  if (typeof gtag === 'function') gtag('event', 'calculator_use', { calculator_name: 'forty_yard_dash' });
}

document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>
