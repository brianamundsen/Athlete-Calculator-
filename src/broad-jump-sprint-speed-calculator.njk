---
<header>
<p class="eyebrow">Free Athletic Performance Tool</p>
<h1>Broad Jump<span>Speed Predictor</span></h1>
<p class="subtitle">Enter your broad jump distance to predict your 40-yard dash time, sprint speed, and see exactly where you rank against athletes at every level.</p>
</header><div class="container">
<div class="links-row">
<a class="site-link" href="https://athletecalculator.com/sprint-speed-calculator">
      ↑ <strong>Sprint Speed</strong> Percentile Calculator
    </a>
<a class="site-link" href="https://athletecalculator.com/vertical-jump-percentile">
      ↑ <strong>Vertical Jump</strong> Percentile Calculator
    </a>
</div>
<!-- INPUT CARD -->
<div class="card">
<p class="card-label">Your Broad Jump</p>
<div class="form-grid">
<div class="field">
<label for="gender">Gender</label>
<select id="gender">
<option value="male">Male</option>
<option value="female">Female</option>
</select>
</div>
<div class="field">
<label for="age">Age Group</label>
<select id="age">
<option value="teen">Teen (13–17)</option>
<option selected="" value="adult">Adult (18–34)</option>
<option value="master">Master (35–50)</option>
</select>
</div>
<!-- Imperial input -->
<div class="full" id="input-imperial">
<div class="ft-in-row">
<div class="field">
<label>Broad Jump — Feet</label>
<input id="bj-ft" max="12" min="3" placeholder="e.g. 9" step="1" type="number"/>
</div>
<div class="field">
<label>Inches</label>
<input id="bj-in" max="11" min="0" placeholder="e.g. 6" step="1" type="number"/>
</div>
</div>
</div>
<!-- Metric input -->
<div class="full" id="input-metric" style="display:none">
<div class="field">
<label for="bj-cm">Broad Jump (cm)</label>
<input id="bj-cm" max="365" min="90" placeholder="e.g. 290" step="1" type="number"/>
</div>
</div>
<div class="field">
<label>Unit</label>
<div class="unit-toggle">
<button class="unit-btn active" onclick="setUnit('imperial', this)">FT / IN</button>
<button class="unit-btn" onclick="setUnit('metric', this)">CM</button>
</div>
</div>
<div class="field">
<label for="position">Sport / Position (optional)</label>
<select id="position">
<option value="general">General / Not sure</option>
<option value="skill">Football — Skill Position</option>
<option value="lineman">Football — Lineman</option>
<option value="basketball">Basketball</option>
<option value="soccer">Soccer / Track</option>
</select>
</div>
</div>
<button class="calc-btn" onclick="calculate()">Predict My Sprint Speed →</button>
</div>
<!-- RESULTS -->
<div id="results">
<!-- GAUGE + CONVERSIONS -->
<div class="gauge-card anim anim-d1">
