<h2>Using Percentages to Program Your Training</h2>
<p>Once you know your 1RM, percentages make it easy to pick the right load. Heavy work at <strong>85–95%</strong> builds maximal strength. The <strong>70–85%</strong> range for sets of 5 to 10 builds muscle and work capacity. Speed and power work, like jump squats and fast cleans, usually sits at <strong>30–60%</strong>, moved as fast as possible. For athletes, strength is the base and speed is the goal; see how strength carries over in <a href="/squat-strength-sprint-speed">does squat strength make you faster</a>.</p>
<h2>Should Young Athletes Test a True 1RM?</h2>
<p>For most high school athletes, an estimated max from a set of 3 to 5 reps is the better choice. It gives coaches a reliable number for programming without the fatigue and technical breakdown of a true max attempt. Any max testing should be supervised, with a spotter or safety bars, and only after the athlete has solid technique on the lift.</p>
<h2>Frequently Asked Questions</h2>
<div class="faq-item">
<div class="faq-q">How do you calculate your one rep max?</div>
<div class="faq-a">Lift a weight you can handle for 2 to 10 good reps, then plug the weight and reps into a formula. The Epley formula is weight × (1 + reps ÷ 30), so 225 pounds for 5 reps estimates a 1RM of about 263 pounds. This calculator averages the Epley, Brzycki and Lombardi formulas.</div>
</div>
<div class="faq-item">
<div class="faq-q">How accurate are 1RM calculators?</div>
<div class="faq-a">From a hard set of 10 reps or fewer, estimates usually land within about 5% of a true max. Accuracy drops at higher reps because muscular endurance varies a lot between people. The closer your set is to 1 to 5 reps, the better the estimate.</div>
</div>
<div class="faq-item">
<div class="faq-q">What is a good bench press for my bodyweight?</div>
<div class="faq-a">For male athletes, benching about 1.0 times bodyweight is a solid college-athlete level, and 1.4 times bodyweight is strong. For female athletes, about 0.65 times bodyweight is a solid college-athlete level and 0.9 times is strong.</div>
</div>
<div class="faq-item">
<div class="faq-q">What percentage of my 1RM should I train at?</div>
<div class="faq-a">For maximal strength, work at 85 to 95 percent for 1 to 5 reps. For building muscle, 70 to 85 percent for 6 to 12 reps. For speed and power, 30 to 60 percent moved as fast as possible.</div>
</div>
<div class="faq-item">
<div class="faq-q">How often should you test your 1 rep max?</div>
<div class="faq-a">Most athletes test or re-estimate every 6 to 12 weeks, usually at the end of a training block. Re-estimating from a heavy set of 3 to 5 reps works just as well for updating training percentages.</div>
</div>
</div>
</div><script>
let unit = 'lb';
function setUnit(u, btn) {
  unit = u;
  document.querySelectorAll('.format-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.unit-lbl').forEach(el => el.textContent = u);
}

// Strength levels as × bodyweight: lower bounds for HS athlete, college athlete, strong, elite
const STANDARDS = {
  m: { squat: [1.0, 1.4, 2.0, 2.5], bench: [0.75, 1.0, 1.4, 1.75], deadlift: [1.25, 1.75, 2.25, 2.75], clean: [0.75, 1.0, 1.3, 1.5] },
  f: { squat: [0.8, 1.1, 1.5, 1.8], bench: [0.5, 0.65, 0.9, 1.1], deadlift: [1.0, 1.3, 1.75, 2.2], clean: [0.5, 0.7, 0.9, 1.1] },
};
const LEVELS = ['Untrained', 'HS Athlete', 'College Athlete', 'Strong', 'Elite'];
const LIFT_NAME = { squat: 'back squat', bench: 'bench press', deadlift: 'deadlift', clean: 'power clean' };
const PCTS = [
  [100, '1', 'Max strength'], [95, '2', 'Max strength'], [90, '3–4', 'Max strength'], [85, '5–6', 'Strength'],
  [80, '7–8', 'Strength / muscle'], [75, '9–10', 'Muscle'], [70, '11–12', 'Muscle / work capacity'],
  [65, '13–15', 'Technique / volume'], [60, '15+', 'Speed-strength'], [50, '—', 'Power / speed work'],
];

function round(v) {
  const step = unit === 'lb' ? 5 : 2.5;
  return Math.round(v / step) * step;
}
function fmt(v) { return `${Math.round(v * 10) / 10} ${unit}`; }

function calculate() {
  const err = document.getElementById('form-error');
  err.textContent = '';
  const w = parseFloat(document.getElementById('w').value);
  const r = parseInt(document.getElementById('reps').value, 10);
  const bw = parseFloat(document.getElementById('bw').value);
  const lift = document.getElementById('lift').value;
  const sex = document.getElementById('sex').value;
  if (isNaN(w) || w <= 0) { err.textContent = 'Enter the weight you lifted.'; return; }
  if (isNaN(r) || r < 1 || r > 15) { err.textContent = 'Enter reps between 1 and 15.'; return; }

  const epley = r === 1 ? w : w * (1 + r / 30);
  const brzycki = w * 36 / (37 - r);
  const lombardi = w * Math.pow(r, 0.10);
  const orm = (epley + brzycki + lombardi) / 3;

  const resultsEl = document.getElementById('results');
  resultsEl.classList.add('visible');
  resultsEl.querySelectorAll('.anim').forEach(el => { el.style.animation = 'none'; el.offsetHeight; el.style.animation = ''; });

  document.getElementById('orm-big').textContent = `${Math.round(orm)} ${unit}`;
  document.getElementById('formula-row').innerHTML = [['Epley', epley], ['Brzycki', brzycki], ['Lombardi', lombardi]]
    .map(([n, v]) => `<div class="conv-item"><div class="conv-val">${Math.round(v)}</div><div class="conv-label">${n}</div></div>`).join('');

  // Strength level
  const levelCard = document.getElementById('level-card');
  let verdict = '', sub = '';
  if (!isNaN(bw) && bw > 0) {
    const ratio = orm / bw;
    const std = STANDARDS[sex][lift];
    let lvl = 0;
    std.forEach((t, i) => { if (ratio >= t) lvl = i + 1; });
    verdict = LEVELS[lvl];
    const next = lvl < 4 ? std[lvl] : null;
    sub = `${ratio.toFixed(2)}× bodyweight on the ${LIFT_NAME[lift]}.` +
      (next ? ` ${LEVELS[lvl + 1]} starts at ${next}× — about ${Math.ceil(next * bw - orm)} ${unit} more.` : ' That is elite for an athlete.');
    const maxR = std[3] * 1.2;
    const bounds = [0, ...std, maxR];
    document.getElementById('level-wrap').innerHTML = LEVELS.map((name, i) => {
      const lo = bounds[i], hi = bounds[i + 1];
      const active = i === lvl;
      const f2 = v => (Math.round(v * 100) / 100).toString();
      const label = i === 4 ? `${f2(lo)}×+` : `${f2(lo)}–${f2(hi)}×`;
      return `<div class="bar-row${active ? ' you-row' : ''}"><div class="bar-label">${name}</div>
        <div class="bar-track"><div class="bar-fill" style="width:0%;background:${active ? 'var(--accent)' : '#1e2c3a'}" data-w="${Math.max(8, (hi / maxR) * 100)}"></div></div>
        <div class="bar-val">${label}</div></div>`;
    }).join('');
    levelCard.style.display = '';
    setTimeout(() => { document.querySelectorAll('#level-wrap .bar-fill').forEach(b => { b.style.width = b.dataset.w + '%'; }); }, 100);
  } else {
    levelCard.style.display = 'none';
    sub = 'Add your bodyweight to see your strength level.';
  }
  document.getElementById('verdict').textContent = verdict;
  document.getElementById('verdict-sub').textContent = sub;

  document.getElementById('pct-body').innerHTML = PCTS.map(([p, reps, use]) =>
    `<tr${p === 100 ? ' class="highlight"' : ''}><td>${p}%</td><td>${round(orm * p / 100)} ${unit}</td><td>${reps}</td><td>${use}</td></tr>`).join('');

  let tip = r > 10
    ? `<strong>Rough estimate:</strong> sets above 10 reps measure endurance as much as strength, so treat this number loosely. A heavy set of 3 to 5 reps will give a sharper estimate. `
    : `The three formulas agree within ${Math.round(Math.max(epley, brzycki, lombardi) - Math.min(epley, brzycki, lombardi))} ${unit}, so this is a solid estimate. `;
  tip += lift === 'squat'
    ? `See what a ${Math.round(orm)} ${unit} squat predicts for your vertical and 40 time with the <a href="/squat-strength-calculator">squat strength calculator</a>.`
    : lift === 'clean'
      ? `Power cleans build the hip extension behind jumping and sprinting. Track yours alongside your <a href="/vertical-jump-percentile">vertical jump</a>.`
      : `For athletes, strength matters most for what it adds to speed and jumping. See how in <a href="/squat-strength-sprint-speed">does squat strength make you faster</a>.`;
  document.getElementById('tip-text').innerHTML = tip;

  setTimeout(() => resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
  if (typeof gtag === 'function') gtag('event', 'calculator_use', { calculator_name: 'one_rep_max', lift });
}
document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>
