let currentUnit = 'imperial';

function setUnit(u, btn) {
  currentUnit = u;
  document.querySelectorAll('.unit-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('input-imperial').style.display = u === 'imperial' ? 'block' : 'none';
  document.getElementById('input-metric').style.display   = u === 'metric'   ? 'block' : 'none';
}

// Standing reach estimate from height (inches)
function standingReach(heightIn, wingspan) {
  const base = heightIn * 1.335; // average ratio
  const adj = { short: -3, average: 0, long: 3, 'very-long': 6 };
  return base + (adj[wingspan] || 0);
}

// Rim clearance needed in inches (hand needs to be 6" above rim = 10'6" = 126")
const RIM_HEIGHT = 120; // 10 feet in inches
const DUNK_HEIGHT = 126; // 10'6" needed

function getColor(gap) {
  if (gap <= 0)  return '#aaff00';
  if (gap <= 4)  return '#ffd600';
  if (gap <= 8)  return '#ff9000';
  return '#ff4d4d';
}

function inchesToFtIn(inches) {
  const ft = Math.floor(inches / 12);
  const inch = Math.round(inches % 12);
  return `${ft}'${inch}"`;
}

function calculate() {
  let heightIn, vertIn;
  const wingspan = document.getElementById('wingspan').value;
  const takeoff  = document.getElementById('takeoff').value;

  if (currentUnit === 'imperial') {
    const ft = parseFloat(document.getElementById('height-ft').value) || 0;
    const inc = parseFloat(document.getElementById('height-in').value) || 0;
    heightIn = ft * 12 + inc;
    vertIn   = parseFloat(document.getElementById('vertical-in').value) || null;
  } else {
    const cm = parseFloat(document.getElementById('height-cm').value) || 0;
    const vcm = parseFloat(document.getElementById('vertical-cm').value) || null;
    heightIn = cm / 2.54;
    vertIn   = vcm ? vcm / 2.54 : null;
  }

  if (!heightIn || heightIn < 48) {
    document.getElementById('height-ft').style.borderColor = 'var(--red)';
    setTimeout(() => document.getElementById('height-ft').style.borderColor = '', 1500);
    return;
  }

  // One-foot takeoff adds ~3 inches on average
  const takeoffBonus = takeoff === 'one' ? 3 : 0;

  const reach   = standingReach(heightIn, wingspan);
  const needed  = DUNK_HEIGHT - reach;
  const neededAdj = Math.max(0, needed - takeoffBonus);

  // If no vertical provided, just show what's needed
  const hasVert = vertIn !== null && !isNaN(vertIn);
  const gap     = hasVert ? neededAdj - vertIn : null;
  const canDunk = hasVert && gap <= 0;

  const resultsEl = document.getElementById('results');
  resultsEl.classList.add('visible');
  resultsEl.querySelectorAll('.anim').forEach(el => {
    el.style.animation = 'none'; el.offsetHeight; el.style.animation = '';
  });

  // ── VERDICT ──
  const verdictCard = document.getElementById('verdict-card');
  verdictCard.className = 'verdict-card anim d1 ' + (canDunk ? 'can-dunk' : 'cannot-dunk');

  const emoji     = document.getElementById('verdict-emoji');
  const headline  = document.getElementById('verdict-headline');
  const subEl     = document.getElementById('verdict-sub');

  if (!hasVert) {
    emoji.textContent     = '📏';
    headline.textContent  = 'Here\'s What You Need';
    headline.style.color  = 'var(--accent)';
    subEl.textContent     = `Based on your height, you need to jump approximately ${neededAdj.toFixed(1)}" to dunk${takeoff === 'one' ? ' off a one-foot approach' : ''}. Enter your vertical jump above to see exactly where you stand.`;
  } else if (canDunk) {
    emoji.textContent     = '🏀';
    headline.textContent  = 'Yes, You Can Dunk!';
    headline.style.color  = 'var(--accent)';
    const margin = Math.abs(gap).toFixed(1);
    subEl.textContent     = `Your vertical clears the dunk threshold by ${margin} inches. ${takeoff === 'one' ? 'Your one-foot approach gives you extra margin.' : 'Now practice your approach mechanics to make it consistent.'}`;
  } else {
    emoji.textContent = gap <= 4 ? '🔥' : gap <= 8 ? '💪' : '📈';
    headline.style.color = getColor(gap);
    if (gap <= 2) {
      headline.textContent = 'So Close!';
      subEl.textContent = `You're only ${gap.toFixed(1)}" away. With approach mechanics and 4–6 weeks of focused training, you could have your first dunk very soon.`;
    } else if (gap <= 6) {
      headline.textContent = 'Almost There';
      subEl.textContent = `You're ${gap.toFixed(1)}" away from dunking. A focused 8–12 week training block combining squats and plyometrics should get you there.`;
    } else if (gap <= 12) {
      headline.textContent = 'Keep Training';
      subEl.textContent = `You're ${gap.toFixed(1)}" away. This is a realistic goal — most athletes close this gap in 4–8 months of consistent training.`;
    } else {
      headline.textContent = 'Long-Term Goal';
      subEl.textContent = `You're ${gap.toFixed(1)}" away. Dunking is achievable but will require 12–18 months of serious training. Start building your squat strength today.`;
    }
  }

  // ── STATS ──
  document.getElementById('stat-reach').textContent  = inchesToFtIn(reach);
  document.getElementById('stat-needed').textContent = neededAdj.toFixed(1) + '"';

  const gapEl    = document.getElementById('stat-gap');
  const gapLabel = document.getElementById('stat-gap-label');

  if (!hasVert) {
    gapEl.textContent   = '?';
    gapLabel.textContent = 'Enter Your Vertical';
  } else if (canDunk) {
    gapEl.textContent    = '+' + Math.abs(gap).toFixed(1) + '"';
    gapEl.style.color    = 'var(--accent)';
    gapLabel.textContent = 'Above Threshold';
  } else {
    gapEl.textContent    = gap.toFixed(1) + '"';
    gapEl.style.color    = getColor(gap);
    gapLabel.textContent = 'Gap to Dunk';
  }

  // ── PROGRESS ──
  const progressSection = document.getElementById('progress-section');
  const progressFill    = document.getElementById('progress-fill');
  const gapDisplay      = document.getElementById('gap-display');

  if (hasVert) {
    const progressPct = Math.min(100, Math.max(0, (vertIn / (neededAdj * 1.1)) * 100));
    const color = getColor(gap);
    setTimeout(() => {
      progressFill.style.width      = progressPct + '%';
      progressFill.style.background = color;
    }, 100);

    if (canDunk) {
      gapDisplay.innerHTML = `Your vertical of <strong>${vertIn}"</strong> clears the ${neededAdj.toFixed(1)}" threshold ✓`;
    } else {
      gapDisplay.innerHTML = `Your vertical: <strong>${vertIn}"</strong> · You need: <strong>${neededAdj.toFixed(1)}"</strong> · Gap: <strong>${gap.toFixed(1)}"</strong>`;
    }
  } else {
    progressSection.style.display = 'none';
  }

  // ── TIMELINE ──
  const timelineTitle = document.getElementById('timeline-title');
  const timelineItems = document.getElementById('timeline-items');
  timelineItems.innerHTML = '';

  if (canDunk) {
    timelineTitle.textContent = 'Now That You Can Dunk';
    const steps = [
      { label: 'Master your approach', desc: 'Practice a two-step or one-step approach at the rim every day. Footwork and timing add 2–4 inches of effective height.' },
      { label: 'Build consistency', desc: 'First dunks are often fluky. Aim to dunk 8 out of 10 attempts before calling it locked in.' },
      { label: 'Try different styles', desc: 'One-hand, two-hand, off one foot or two — each requires slightly different timing. Explore what works best for your body.' },
    ];
    steps.forEach((s, i) => {
      timelineItems.innerHTML += `<div class="timeline-item"><div class="timeline-num">${i+1}</div><div class="timeline-content"><div class="timeline-label">${s.label}</div><div class="timeline-desc">${s.desc}</div></div></div>`;
    });
  } else if (!hasVert || gap <= 4) {
    timelineTitle.textContent = 'Your 6-Week Plan';
    const steps = [
      { label: 'Week 1–2: Fix your approach', desc: 'Practice approach jumps daily at the rim. A good two-step approach can add 3–5 inches immediately without any fitness change.' },
      { label: 'Week 3–4: Depth jumps', desc: 'Step off a 12-inch box, land, and immediately explode upward. 3 sets of 6 reps twice a week trains the reactive power that puts you over the rim.' },
      { label: 'Week 5–6: Heavy squats + plyos', desc: 'Squat heavy 2× per week and do box jumps on alternate days. This combination produces the fastest vertical jump gains of any training approach.' },
    ];
    steps.forEach((s, i) => {
      timelineItems.innerHTML += `<div class="timeline-item"><div class="timeline-num">${i+1}</div><div class="timeline-content"><div class="timeline-label">${s.label}</div><div class="timeline-desc">${s.desc}</div></div></div>`;
    });
  } else if (gap <= 10) {
    timelineTitle.textContent = 'Your 12-Week Plan';
    const steps = [
      { label: 'Month 1: Build your squat', desc: 'Get your squat to 1.5× bodyweight if you\'re not there yet. This is the foundation. Squat heavy 3× per week with progressive overload.' },
      { label: 'Month 2: Add plyometrics', desc: 'Introduce depth jumps, box jumps, and single-leg bounds twice per week. These train the explosive power that converts strength into jump height.' },
      { label: 'Month 3: Approach work + peak', desc: 'Practice approach mechanics daily. Reduce squat volume to keep your legs fresh. This is when you test your dunk at the end of the month.' },
    ];
    steps.forEach((s, i) => {
      timelineItems.innerHTML += `<div class="timeline-item"><div class="timeline-num">${i+1}</div><div class="timeline-content"><div class="timeline-label">${s.label}</div><div class="timeline-desc">${s.desc}</div></div></div>`;
    });
  } else {
    timelineTitle.textContent = 'Your Long-Term Plan';
    const steps = [
      { label: 'Phase 1 (Months 1–4): Strength foundation', desc: 'Build your squat to 1.5× bodyweight. This alone will add 4–6 inches to your vertical jump when combined with basic plyometrics.' },
      { label: 'Phase 2 (Months 5–8): Power development', desc: 'Contrast training, Olympic lift variations, and reactive plyometrics convert your strength gains into explosive power.' },
      { label: 'Phase 3 (Months 9–12): Skill refinement', desc: 'Approach mechanics, arm swing timing, and daily rim touches. The last few inches often come from skill, not fitness.' },
    ];
    steps.forEach((s, i) => {
      timelineItems.innerHTML += `<div class="timeline-item"><div class="timeline-num">${i+1}</div><div class="timeline-content"><div class="timeline-label">${s.label}</div><div class="timeline-desc">${s.desc}</div></div></div>`;
    });
  }

  // ── TIP ──
  const tips = [
    { cond: canDunk,       text: `<strong>You're already dunking</strong> — now build consistency and try your first in-game dunk. Use our <a href="/vertical-jump-percentile" style="color:var(--accent)">Vertical Jump Calculator</a> to see how your jump ranks against other athletes.` },
    { cond: !hasVert,      text: `<strong>Measure your vertical jump</strong> and come back to get your full dunk analysis. Our <a href="/vertical-jump-percentile" style="color:var(--accent)">Vertical Jump Percentile Calculator</a> also shows where you rank against athletes at every level.` },
    { cond: gap <= 4,      text: `<strong>You're this close</strong> — the fastest gains right now come from approach mechanics, not fitness. Practice your run-up at the rim every single day. Many athletes dunk for the first time within days of figuring out their approach.` },
    { cond: gap <= 10,     text: `<strong>Your squat strength</strong> is the most direct lever. Use our <a href="/squat-strength-calculator" style="color:var(--accent)">Squat Strength Predictor</a> to see exactly what squat target will get your vertical to dunk height.` },
    { cond: true,          text: `<strong>Start with your squat.</strong> Use our <a href="/squat-strength-calculator" style="color:var(--accent)">Squat Strength Predictor</a> to find your squat target for dunking, and our <a href="/how-much-to-squat-to-dunk" style="color:var(--accent)">full dunking guide</a> for the complete training plan.` },
  ];

  const tip = tips.find(t => t.cond);
  document.getElementById('tip-text').innerHTML = tip.text;

  setTimeout(() => resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);

  if (typeof gtag === 'function') {
    gtag('event', 'calculator_use', { 'calculator_name': 'can_i_dunk' });
  }
}

document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>