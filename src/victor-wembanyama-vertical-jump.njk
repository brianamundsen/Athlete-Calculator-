<!-- SECTION 1 -->
<h2>The Numbers</h2>
<div class="player-card">
<div class="player-name">Victor Wembanyama</div>
<div class="player-sub">San Antonio Spurs · Center / Forward · Born January 4, 2004</div>
<div class="player-stats">
<div class="player-stat dimmed">
<div class="player-stat-val">32"</div>
<div class="player-stat-label">Vertical Jump</div>
</div>
