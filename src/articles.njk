    const groups = document.querySelectorAll('.category-group');
    groups.forEach(group => {
      if (cat === 'all' || group.dataset.cat === cat) {
        group.removeAttribute('hidden');
      } else {
        group.setAttribute('hidden', '');
      }
    });
  }
