</div>
<div class="rank-row">
<div class="rank-label"><strong>Wingspan</strong>7'4"</div>
<div class="rank-track"><div class="rank-fill" style="width:91%;background:#aaff00"></div></div>
<div class="rank-val">Top 5% forwards</div>
</div>
<div class="rank-row">
<div class="rank-label"><strong>Wing Differential</strong>+5"</div>
<div class="rank-track"><div class="rank-fill" style="width:88%;background:#aaff00"></div></div>
