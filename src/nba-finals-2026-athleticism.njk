<tr class="hl-spurs"><td>D. Harper</td><td>Spurs</td><td>6'4.5"</td><td>6'10.5"</td><td>—</td><td>215 lb</td><td>—</td></tr>
<tr class="hl-knicks"><td>K-A. Towns</td><td>Knicks</td><td>7'0"</td><td>7'3.25"</td><td>36.5"</td><td>248 lb</td><td>~11'8"</td></tr>
