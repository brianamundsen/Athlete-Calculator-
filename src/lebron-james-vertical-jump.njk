<tbody>
<tr><td>Gerald Sensabaugh</td><td>~210 lb</td><td>46" (combine)</td><td>~11'6"</td><td>Yes — combine</td></tr>
<tr><td>Zion Williamson</td><td>~285 lb</td><td>45" (combine)</td><td>~12'4"</td><td>Yes — combine</td></tr>
<tr class="highlight"><td>LeBron James</td><td>~250 lb</td><td>~44" (reported)</td><td>~12'0"</td><td>Estimated</td></tr>
<tr><td>Vince Carter</td><td>~220 lb</td><td>~43" (reported)</td><td>~11'8"</td><td>Estimated</td></tr>
<tr><td>NBA SF Average</td><td>~222 lb</td><td>36"</td><td>~11'6"</td><td>Combine avg</td></tr>
