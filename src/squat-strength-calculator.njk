---
<header>
<p class="eyebrow">Free Athletic Performance Tool</p>
<h1>Squat Strength<span>Predictor</span></h1>
<p class="subtitle">Enter your squat max and bodyweight to predict your vertical jump and sprint speed — and see exactly what strength gains will do for your athleticism.</p>
</header><div class="container">
<div class="links-row">
<a class="site-link" href="/">
      ↑ <strong>Vertical Jump</strong> Percentile Calculator
    </a>
<a class="site-link" href="/sprint-speed-calculator">
      ↑ <strong>Sprint Speed</strong> Percentile Calculator
    </a>
</div>
<div class="card">
<p class="card-label">Your Stats</p>
<div class="form-grid">
<div class="field">
<label for="gender">Gender</label>
<select id="gender">
<option value="male">Male</option>
<option value="female">Female</option>
</select>
</div>
<div class="field">
<label for="squat-type">Squat Type</label>
<select id="squat-type">
<option value="back">Back Squat (1RM)</option>
<option value="front">Front Squat (1RM)</option>
<option value="box">Box Squat (1RM)</option>
</select>
</div>
<div class="field">
<label>Bodyweight</label>
<input id="bodyweight" max="400" min="50" placeholder="e.g. 185" step="1" type="number"/>
</div>
<div class="field">
<label>Unit</label>
<div class="unit-toggle">
<button class="unit-btn active" onclick="setUnit('lbs', this)">LBS</button>
<button class="unit-btn" onclick="setUnit('kg', this)">KG</button>
</div>
</div>
<div class="field full">
<label>Squat 1 Rep Max (same unit as bodyweight)</label>
<input id="squat-max" max="1200" min="50" placeholder="e.g. 275" step="1" type="number"/>
</div>
</div>
<button class="calc-btn" onclick="calculate()">Predict My Performance →</button>
</div>
<div id="results">
<div class="gauge-card anim anim-d1">
<div class="gauge-card-title">Strength-to-Bodyweight Ratio</div>
<svg class="gauge-svg" style="display:block;margin:0 auto 1.5rem;width:260px;height:140px;" viewbox="0 0 260 140">
<path class="gauge-track" d="M 20 130 A 110 110 0 0 1 240 130"></path>
<path class="gauge-fill" d="M 20 130 A 110 110 0 0 1 240 130" id="gauge-path" stroke="var(--accent)" stroke-dasharray="345" stroke-dashoffset="345"></path>
<text fill="var(--accent)" font-family="'Barlow Condensed', sans-serif" font-size="52" font-weight="900" id="gauge-num" text-anchor="middle" x="130" y="100">—</text>
<text fill="var(--text-muted)" font-family="'DM Mono', monospace" font-size="9" letter-spacing="1.5" text-anchor="middle" x="130" y="120">× BODYWEIGHT</text>
<text fill="var(--text-muted)" font-family="'DM Mono', monospace" font-size="8" id="gauge-sub" letter-spacing="1" text-anchor="middle" x="130" y="132">—</text>
</svg>
<div class="verdict" id="verdict">—</div>
<div class="verdict-sub" id="verdict-sub">—</div>
</div>
<div style="max-width: 500px; margin: 2rem auto; padding: 1.75rem; background: #0d1218; border: 1px solid var(--accent); border-radius: 12px; text-align: center; box-shadow: 0 0 24px var(--accent-glow);">
<div style="font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--accent); margin-bottom: 0.6rem;">FREE 5-DAY COURSE</div>
<h3 style="color: var(--text); font-family: 'Barlow Condensed', sans-serif; font-size: 1.4rem; font-weight: 900; margin: 0 0 0.6rem;">
        Get Your Free 5-Day Vertical Jump Plan
      </h3>
<p style="color: var(--text-mid); font-size: 0.9rem; line-height: 1.4; margin-bottom: 1.25rem;">
        Strength is the foundation. The exact strength, plyometric, and recovery sequence to turn your squat numbers into a higher vertical — delivered straight to your inbox.
      </p>
<div class="ml-embedded" data-form="XBngsi"></div>
</div>
<div class="dual-results anim anim-d2">
<div class="result-card vert">
<div class="result-card-eyebrow">Predicted Vertical Jump</div>
<div class="result-main" id="pred-vert" style="color:var(--accent)">—</div>
<div class="result-unit">inches</div>
<div class="result-range" id="pred-vert-range">—</div>
<div id="pred-vert-cm" style="margin-top:0.75rem;font-size:0.72rem;color:var(--text-muted)">—</div>
</div>
<div class="result-card sprint">
<div class="result-card-eyebrow">Predicted 40-Yd Dash</div>
<div class="result-main" id="pred-sprint" style="color:var(--orange)">—</div>
<div class="result-unit">seconds</div>
<div class="result-range" id="pred-sprint-range">—</div>
<div id="pred-sprint-mph" style="margin-top:0.75rem;font-size:0.72rem;color:var(--text-muted)">—</div>
</div>
</div>
<div class="scale-card anim anim-d3">
<div class="scale-card-title">How Your Squat Compares</div>
<div class="scale-strip">
<div style="background:#ff4d4d"></div>
<div style="background:#ff7a00"></div>
<div style="background:#ffd600"></div>
<div style="background:#7fff00"></div>
<div style="background:#aaff00"></div>
</div>
<div class="scale-labels">
<span>Untrained</span><span>Beginner</span><span>Intermediate</span><span>Strong</span><span>Elite</span>
</div>
<div id="scale-rows"></div>
</div>
<div class="scale-card anim anim-d4" id="whatif-card">
<div class="scale-card-title">What Happens If You Get Stronger?</div>
<div id="whatif-rows"></div>
</div>
<div class="info-card anim anim-d4">
<div class="info-icon">🏋️</div>
<div class="info-text" id="tip-text">—</div>
</div>
<div class="next-card anim anim-d5">
<div class="next-card-title">Your Training Priority</div>
<div id="next-steps"></div>
</div>
</div>
</div><script>
let currentUnit = 'lbs';

function setUnit(u, btn) {
  currentUnit = u;
  document.querySelectorAll('.unit-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('bodyweight').placeholder = u === 'lbs' ? 'e.g. 185' : 'e.g. 84';
  document.getElementById('squat-max').placeholder  = u === 'lbs' ? 'e.g. 275' : 'e.g. 125';
}

function toLbs(val) { return currentUnit === 'kg' ? val * 2.20462 : val; }

// Adjust 1RM for squat type (front and box are slightly lower predictive value for vert)
function adjustedSquat(raw, type) {
  if (type === 'front') return raw * 1.08; // front squat ~92% of back squat equivalent
  if (type === 'box')   return raw * 1.05;
  return raw;
}

// ─── PREDICTION MODELS ───────────────────────────────────────────────────────
// Based on Baker & Nance (1999), Wisløff et al. (2004), and NSCA research
// Vertical jump (inches) from relative squat strength (ratio = squat/BW)
function predictVert(ratio, gender) {
  const base = gender === 'male'
    ? 8 + (ratio * 12.5)   // male: ~0.5x BW → ~14in, 2.0x → ~33in
    : 6 + (ratio * 10.0);  // female: ~0.5x BW → ~11in, 1.5x → ~21in

  // Diminishing returns above 2.0x BW
  const adj = ratio > 2.0 ? base + (ratio - 2.0) * 3 : base;
  return Math.min(gender === 'male' ? 44 : 36, Math.max(6, adj));
}

// 40-yard dash (seconds) from relative squat strength
function predictSprint(ratio, gender) {
  const base = gender === 'male'
    ? 5.8 - (ratio * 0.72)   // male: ~0.5x → ~5.44s, 2.0x → ~4.36s
    : 7.0 - (ratio * 0.75);  // female: ~0.5x → ~6.63s, 2.0x → ~5.50s

  return Math.max(gender === 'male' ? 4.2 : 4.6, Math.min(gender === 'male' ? 6.5 : 8.0, base));
}

function getMph(t40) { return (36.576 / t40) * 2.23694; }

function getColor(ratio) {
  if (ratio < 0.75) return '#ff4d4d';
  if (ratio < 1.0)  return '#ff9000';
  if (ratio < 1.3)  return '#ffd600';
  if (ratio < 1.6)  return '#9dff00';
  if (ratio < 2.0)  return '#aaff00';
  return '#00cfff';
}

// Ratio to gauge percent (0.5x = 10%, 2.5x+ = 100%)
function ratioToPct(ratio) {
  return Math.min(100, Math.max(0, ((ratio - 0.4) / (2.6 - 0.4)) * 100));
}

const verdicts = [
  { max: 0.75, label: "Untrained",         sub: "Building your squat is the single highest-leverage thing you can do for your athleticism right now." },
  { max: 1.0,  label: "Beginner Strength", sub: "You have a foundation. Getting to 1.5x bodyweight will produce noticeable jumps in both your vertical and speed." },
  { max: 1.3,  label: "Intermediate",      sub: "Solid base. Hitting 1.5–1.6x bodyweight is where most athletes start feeling genuinely explosive." },
  { max: 1.6,  label: "Solidly Strong",    sub: "You're in the range where strength is translating into real athleticism. Keep pushing to 2.0x." },
  { max: 2.0,  label: "Very Strong",       sub: "This is elite strength for most sports. Your squat is a real asset. Plyometrics will now multiply your gains." },
  { max: 99,   label: "Exceptionally Strong", sub: "Top-end strength. At this level, rate of force development and plyometric efficiency are your performance levers." },
];

function animateNum(el, target, dur, decimals) {
  decimals = decimals !== undefined ? decimals : 0;
  const start = performance.now();
  const from  = parseFloat(el.textContent.replace(/[^\d.-]/g, '')) || 0;
  function step(now) {
    const p    = Math.min((now - start) / dur, 1);
    const ease = 1 - Math.pow(1 - p, 4);
    el.textContent = (from + (target - from) * ease).toFixed(decimals);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function calculate() {
  const gender    = document.getElementById('gender').value;
  const sqType    = document.getElementById('squat-type').value;
  const bwRaw     = parseFloat(document.getElementById('bodyweight').value);
  const sqRaw     = parseFloat(document.getElementById('squat-max').value);

  let hasError = false;
  [['bodyweight', bwRaw], ['squat-max', sqRaw]].forEach(([id, val]) => {
    if (isNaN(val) || val <= 0) {
      document.getElementById(id).style.borderColor = 'var(--red)';
      setTimeout(() => document.getElementById(id).style.borderColor = '', 1500);
      hasError = true;
    }
  });
  if (hasError) return;

  const bwLbs  = toLbs(bwRaw);
  const sqLbs  = adjustedSquat(toLbs(sqRaw), sqType);
  const ratio  = sqLbs / bwLbs;
  const color  = getColor(ratio);
  const v      = verdicts.find(x => ratio < x.max) || verdicts[verdicts.length - 1];

  const vert   = predictVert(ratio, gender);
  const t40    = predictSprint(ratio, gender);
  const mph    = getMph(t40);
  const vertCm = vert * 2.54;

  // Show results
  const resultsEl = document.getElementById('results');
  resultsEl.classList.add('visible');
  resultsEl.querySelectorAll('.anim').forEach(el => {
    el.style.animation = 'none'; el.offsetHeight; el.style.animation = '';
  });

  // ── GAUGE ──
  const gaugePath = document.getElementById('gauge-path');
  const gaugeNum  = document.getElementById('gauge-num');
  const gaugeSub  = document.getElementById('gauge-sub');
  const pct       = ratioToPct(ratio);
  const totalLen  = 345;
  const offset    = totalLen - (pct / 100) * totalLen;

  gaugePath.style.stroke = color;
  gaugePath.style.strokeDashoffset = totalLen;
  setTimeout(() => { gaugePath.style.strokeDashoffset = offset; }, 50);

  gaugeNum.style.fill = color;
  animateNum(gaugeNum, ratio, 1200, 2);

  const bwKg = currentUnit === 'kg' ? bwRaw : bwRaw / 2.20462;
  const sqKg = currentUnit === 'kg' ? sqRaw : sqRaw / 2.20462;
  gaugeSub.textContent = `${sqRaw}${currentUnit} ÷ ${bwRaw}${currentUnit}`;

  document.getElementById('verdict').textContent = v.label;
  document.getElementById('verdict').style.color = color;
  document.getElementById('verdict-sub').textContent = v.sub;

  // ── PREDICTED RESULTS ──
  const vertEl   = document.getElementById('pred-vert');
  const sprintEl = document.getElementById('pred-sprint');

  vertEl.style.color   = color;
  sprintEl.style.color = '#ff9000';

  animateNum(vertEl,   vert, 1000, 1);
  animateNum(sprintEl, t40,  1000, 2);

  // Ranges (±10% variation for individual differences)
  document.getElementById('pred-vert-range').textContent =
    `Range: ${(vert * 0.88).toFixed(1)}″ – ${(vert * 1.12).toFixed(1)}″`;
  document.getElementById('pred-sprint-range').textContent =
    `Range: ${(t40 * 0.97).toFixed(2)}s – ${(t40 * 1.03).toFixed(2)}s`;

  document.getElementById('pred-vert-cm').textContent   = `≈ ${vertCm.toFixed(1)} cm`;
  document.getElementById('pred-sprint-mph').textContent = `≈ ${mph.toFixed(1)} mph top speed`;

  // ── STRENGTH SCALE ROWS ──
  const scaleRows = document.getElementById('scale-rows');
  scaleRows.innerHTML = '';

  const levels = [
    { label: 'You',              ratio: ratio, isYou: true },
    { label: 'Beginner (1.0×)',  ratio: 1.0 },
    { label: 'Intermediate (1.3×)', ratio: 1.3 },
    { label: 'Strong (1.6×)',    ratio: 1.6 },
    { label: 'Elite (2.0×)',     ratio: 2.0 },
  ];

  const maxRatio = 2.4;

  levels.forEach(d => {
    const widthPct = Math.min(100, (d.ratio / maxRatio) * 100);
    const c = d.isYou ? color : '#1e2c3a';

    const row = document.createElement('div');
    row.className = 'scale-row' + (d.isYou ? ' you-row' : '');
    row.innerHTML = `
      <div class="scale-label">${d.label}</div>
      <div class="scale-track">
        <div class="scale-fill" style="width:0%;background:${c}" data-w="${widthPct}"></div>
        ${d.isYou ? `<div class="scale-you-marker" style="left:${widthPct}%"></div>` : ''}
      </div>
      <div class="scale-val">${d.ratio.toFixed(2)}×</div>`;
    scaleRows.appendChild(row);
  });

  setTimeout(() => {
    document.querySelectorAll('.scale-fill').forEach(b => { b.style.width = b.dataset.w + '%'; });
  }, 100);

  // ── WHAT IF TABLE ──
  const whatifRows = document.getElementById('whatif-rows');
  whatifRows.innerHTML = '';

  const targets = [1.25, 1.5, 1.75, 2.0, 2.25].filter(t => t > ratio + 0.1).slice(0, 4);

  if (targets.length === 0) {
    whatifRows.innerHTML = `<p style="font-size:0.85rem;color:var(--text-mid)">You're already at an elite strength level. Focus on plyometrics and speed-specific training to maximize your power output.</p>`;
  } else {
    targets.forEach(target => {
      const futureVert   = predictVert(target, gender);
      const futureSprint = predictSprint(target, gender);
      const vertGain     = futureVert - vert;
      const sprintGain   = t40 - futureSprint;
      const newSqLbs     = target * bwLbs;
      const newSqDisplay = currentUnit === 'lbs'
        ? `${Math.round(newSqLbs)} lbs`
        : `${Math.round(newSqLbs / 2.20462)} kg`;

      const row = document.createElement('div');
      row.className = 'scale-row';
      row.style.cssText = 'align-items:flex-start;margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid var(--border);';
      row.innerHTML = `
        <div class="scale-label" style="width:90px;padding-top:0.1rem">
          <span style="font-family:var(--font-display);font-size:1.1rem;font-weight:800;color:${getColor(target)}">${target.toFixed(2)}×</span><br>
          <span style="font-size:0.65rem;color:var(--text-muted)">${newSqDisplay} squat</span>
        </div>
        <div style="flex:1;padding-left:0.5rem">
          <div style="font-size:0.8rem;color:var(--accent);font-weight:600;margin-bottom:0.2rem">
            +${vertGain.toFixed(1)}" vertical → ${futureVert.toFixed(1)}"
          </div>
          <div style="font-size:0.8rem;color:#ff9000;font-weight:600">
            −${sprintGain.toFixed(2)}s on 40yd → ${futureSprint.toFixed(2)}s
          </div>
        </div>`;
      whatifRows.appendChild(row);
    });
  }

  // ── TRAINING TIP ──
  const tips = [
    { max: 0.9,  text: `<strong>Your move:</strong> A beginner linear progression like <strong>5x5 squats</strong> 2–3x per week will move your numbers fast. At your level, adding 5–10 lbs per session is realistic. Focus on depth and bracing before adding load.` },
    { max: 1.3,  text: `<strong>Next step:</strong> You're past beginner gains. A <strong>3-day per week squat program</strong> with progressive overload — squatting Monday, Wednesday, Friday — is optimal. Prioritize reaching 1.5× bodyweight as your first major athletic milestone.` },
    { max: 1.6,  text: `<strong>Optimize now:</strong> At your strength level, pairing squats with <strong>plyometric training</strong> multiplies your output. Your muscles can produce force — now train the nervous system to do it faster. Add depth jumps and box jumps on non-squat days.` },
    { max: 2.0,  text: `<strong>Rate of force development:</strong> You're strong. Your gains now come from how <strong>fast</strong> you can express that strength. Olympic lift variations (hang cleans, jump squats), contrast training, and reactive plyometrics are your next level.` },
    { max: 99,   text: `<strong>Peak performance:</strong> At elite strength levels, gains come from <strong>specificity and timing</strong>. Maintain strength with lower volume, prioritize reactive ability and top-end speed. Overtraining is a real risk — manage load carefully.` },
  ];
  const tip = tips.find(t => ratio < t.max) || tips[tips.length - 1];
  document.getElementById('tip-text').innerHTML = tip.text;

  // ── NEXT STEPS ──
  const nextSteps = document.getElementById('next-steps');
  const steps = ratio < 1.5
    ? [
        { title: 'Build your squat', body: `Your primary goal is getting to <strong>1.5× bodyweight</strong>. This single milestone will produce the biggest jump in your vertical and 40 time. Squat heavy 2–3x per week.` },
        { title: 'Add basic plyometrics', body: `Even while building strength, doing <strong>3 sets of box jumps</strong> twice per week teaches your nervous system to express force explosively. Keep it simple at this stage.` },
        { title: 'Check your vertical now', body: `Use our <strong><a href="/" style="color:var(--accent)">Vertical Jump Calculator</a></strong> to get your baseline, then retest every 8 weeks to track your progress.` },
      ]
    : ratio < 2.0
    ? [
        { title: 'Combine strength + plyos', body: `At your level, <strong>contrast training</strong> is highly effective — pair a heavy squat set immediately with a max-effort box jump. Your nervous system learns to apply force faster.` },
        { title: 'Sprint work twice a week', body: `<strong>Resisted sprint training</strong> (sled pushes, band-resisted sprints) at 10–20% bodyweight resistance 2x per week will translate your squat strength directly into 40 time.` },
        { title: 'Track your speed', body: `Use our <strong><a href="/sprint-speed-calculator" style="color:var(--accent)">Sprint Speed Calculator</a></strong> to see your current percentile and benchmark your progress.` },
      ]
    : [
        { title: 'Optimize rate of force development', body: `At elite strength, <strong>how fast</strong> you produce force matters more than how much. Olympic lift variations and reactive plyometrics are your primary tools.` },
        { title: 'Maintain, don\'t always build', body: `Heavy squatting at this level requires significant recovery. <strong>Strength maintenance</strong> at 2–3 sessions per week lets you prioritize speed and power work without overreaching.` },
        { title: 'Compare yourself to the best', body: `At your strength level, test yourself against elite benchmarks using our <strong><a href="/" style="color:var(--accent)">Vertical Jump</a></strong> and <strong><a href="/sprint-speed-calculator" style="color:var(--accent)">Sprint Speed</a></strong> calculators.` },
      ];

  nextSteps.innerHTML = steps.map((s, i) => `
    <div class="next-item">
      <div class="next-num">${i + 1}</div>
      <div class="next-text"><strong>${s.title}.</strong> ${s.body}</div>
    </div>`).join('');

  setTimeout(() => resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);

  if (typeof gtag === 'function') {
    gtag('event', 'calculator_use', { 'calculator_name': 'squat_strength' });
  }
}

document.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
</script>