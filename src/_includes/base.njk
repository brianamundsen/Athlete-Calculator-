<!-- Shared nav styling: fallback for pages whose own <style> block never defined nav rules (the 5 calculator pages had no <nav> in the original site) -->
<style>
  nav {
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    position: sticky;
    top: 0;
    background: rgba(8,12,16,0.95);
    backdrop-filter: blur(12px);
    z-index: 100;
  }
  .nav-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
    text-decoration: none;
  }
  .nav-brand span { color: var(--accent); }
  .nav-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .nav-links a {
    color: var(--text-mid);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--accent); }

  footer {
    text-align: center;
    padding: 2rem 1.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    line-height: 1.8;
  }
  footer a { color: var(--text-muted); text-decoration: none; }
  footer a:hover { color: var(--accent); }

  /* Fix: CSS Grid items don't shrink below their content's natural width by default,
     which can cause horizontal overflow on narrow screens with long uppercase labels. */
  [class*="stat"] { min-width: 0; overflow-wrap: break-word; }

  /* Fix: comparison-bar rows with fixed-width labels/values had no mobile fallback,
     causing horizontal overflow on narrow screens (pre-existing gap in original design).
     Applied unconditionally (not gated to a breakpoint) since flex-wrap and width:auto
     only take effect when content doesn't fit — harmless on wider screens. */
  .rank-row { flex-wrap: wrap; row-gap: 0.35rem; }
  .rank-label { width: auto; min-width: 130px; }
  .rank-val { width: auto; margin-left: auto; }
  .rank-track { flex-basis: 200px; flex-grow: 1; order: 3; }
  .week-header { flex-wrap: wrap; }
  .week-focus { margin-left: 0; }

  /* Fix: speed-bar-row is structurally identical to rank-row (same overflow gap) */
  .speed-bar-row { flex-wrap: wrap; row-gap: 0.35rem; }
  .speed-bar-label { width: auto; min-width: 130px; }
  .speed-bar-val { width: auto; margin-left: auto; }
  .speed-bar-track { flex-basis: 200px; flex-grow: 1; order: 3; }

  /* Fix: data tables had no responsive handling at all — on narrow screens with
     several columns, content was clipped (not scrollable) due to overflow:hidden
     on the table itself, used for its rounded corners. Making the table scroll
     horizontally instead preserves the column layout without cutting anything off. */
  .data-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }

  /* Fix: callout-text is a flex child with no min-width/flex set, so it doesn't
     shrink to wrap and instead overflows past the container (same root cause as
     the nav-brand/rank-row issues: flex items default to a content-based min-width). */
  .callout-text { min-width: 0; flex: 1; }
</style>
{% if pageStyle %}{{ pageStyle | safe }}{% endif %}
<style>
  /* Fix: several pages hard-code a grid column count that only switches to fewer
     columns below an exact pixel breakpoint (e.g. 500px). Devices with a viewport
     just above that number never get the fallback and overflow. Auto-fit sizes
     columns based on available space instead of a guessed number, so it works
     correctly at any width without needing another breakpoint. */
  .player-stats { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
  .stat-callout { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
  .results-strip { grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); }
  .player-spot-stats { grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); }
  .player-mini-stats { grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); }

  /* Fix: many pages independently built a "label — bar — value" row component,
     each with a slightly different class name (rank-label, speed-label, bar-label,
     pct-label, wing-label, scale-label, ratio-label, pos-label, record-age, etc.)
     but the same underlying bug: a fixed-width label/value with flex-shrink:0,
     which cannot shrink below its pixel width and overflows on narrow screens.
     This catches every "-label"/"-val"/"-age" variant in one rule instead of
     patching each class name individually as new ones are found. */
  [class$="-label"], [class$="-val"], [class$="-age"] {
    flex-shrink: 1;
    min-width: 0;
    overflow-wrap: break-word;
  }
</style>
